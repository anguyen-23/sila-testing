# Headscale configuration — managed by Ansible
# https://github.com/juanfont/headscale/blob/main/config-example.yaml

server_url: {{ headscale_server_url }}
listen_addr: {{ headscale_listen_addr }}:{{ headscale_listen_port }}
metrics_listen_addr: 127.0.0.1:9090

private_key_path: {{ headscale_data_dir }}/private.key
noise:
  private_key_path: {{ headscale_data_dir }}/noise_private.key

# IP prefixes for Tailscale clients
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: false
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  auto_update_enabled: true
  update_frequency: 24h

database:
  type: sqlite
  sqlite:
    path: {{ headscale_data_dir }}/db.sqlite

log:
  level: info

dns:
  base_domain: {{ headscale_base_domain }}
  magic_dns: true
  nameservers:
    global:
      - 1.1.1.1
      - 8.8.8.8
