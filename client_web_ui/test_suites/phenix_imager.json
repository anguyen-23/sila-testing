{
  "name": "Phenix Imager Test Suite",
  "description": "Comprehensive test suite for the PerkinElmer Opera Phenix RCI wrapper server",
  "server": {
    "default_host": "127.0.0.1",
    "default_port": 50058,
    "feature_id": "PhenixImager",
    "connection": {
      "feature": "PhenixImager",
      "command": "Connect",
      "sim_params": {"PhenixHost": "SIM"},
      "real_params": {"PhenixHost": "$PHENIX_HOST"}
    },
    "variables": {
      "PHENIX_HOST": "10.11.63.100"
    }
  },
  "categories": [
    {
      "id": "comm",
      "name": "Communication & Connection",
      "description": "Basic connection, disconnection, and error handling",
      "tests": [
        {
          "id": "comm_connect_sim",
          "name": "Connect (Simulation)",
          "description": "Connect to simulated Phenix imager",
          "modes": ["simulation"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "SimulationController", "command": "StartSimulationMode"},
            {"action": "command", "feature": "PhenixImager", "command": "Disconnect", "allow_error": true},
            {"action": "command", "feature": "PhenixImager", "command": "Connect", "params": {"PhenixHost": "SIM"}},
            {"action": "check_response", "field": "DeviceName", "operator": "not_empty"}
          ]
        },
        {
          "id": "comm_connect_real",
          "name": "Connect (Real Hardware)",
          "description": "Connect to real Phenix imager",
          "modes": ["real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "SimulationController", "command": "StopSimulationMode"},
            {"action": "command", "feature": "PhenixImager", "command": "Disconnect", "allow_error": true},
            {"action": "command", "feature": "PhenixImager", "command": "Connect", "params": {"PhenixHost": "$PHENIX_HOST"}},
            {"action": "check_response", "field": "DeviceName", "operator": "not_empty"}
          ]
        },
        {
          "id": "comm_connect_invalid",
          "name": "Connect to Invalid Host",
          "description": "Verify CommunicationError on invalid host",
          "modes": ["real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "SimulationController", "command": "StopSimulationMode"},
            {"action": "command", "feature": "PhenixImager", "command": "Connect", "params": {"PhenixHost": "invalid.host.xyz"}, "expect_error": "CommunicationError"}
          ]
        },
        {
          "id": "comm_disconnect",
          "name": "Disconnect",
          "description": "Disconnect from connected device",
          "modes": ["simulation"],
          "type": "scripted",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "command", "feature": "PhenixImager", "command": "Disconnect"}
          ]
        },
        {
          "id": "comm_reconnect",
          "name": "Reconnect",
          "description": "Disconnect and reconnect to device",
          "modes": ["simulation"],
          "type": "scripted",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "command", "feature": "PhenixImager", "command": "Disconnect"},
            {"action": "command", "feature": "PhenixImager", "command": "Connect", "params": {"PhenixHost": "SIM"}},
            {"action": "check_response", "field": "DeviceName", "operator": "not_empty"}
          ]
        },
        {
          "id": "comm_command_disconnected",
          "name": "Command When Disconnected",
          "description": "Verify NotConnected error when running commands while disconnected",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "PhenixImager", "command": "Disconnect", "allow_error": true},
            {"action": "command", "feature": "PhenixImager", "command": "GoIdle", "expect_error": "NotConnected"}
          ]
        }
      ]
    },
    {
      "id": "sim",
      "name": "Simulation Mode Switching",
      "description": "Start/stop simulation mode and verify connection behavior",
      "tests": [
        {
          "id": "sim_start",
          "name": "Start Simulation Mode",
          "description": "Start simulation mode",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "SimulationController", "command": "StartSimulationMode"}
          ]
        },
        {
          "id": "sim_stop",
          "name": "Stop Simulation Mode",
          "description": "Stop simulation mode",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "SimulationController", "command": "StopSimulationMode"}
          ]
        },
        {
          "id": "sim_switch_disconnects",
          "name": "Mode Switch Disconnects",
          "description": "Verify that switching simulation mode disconnects active connection",
          "modes": ["simulation"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "SimulationController", "command": "StartSimulationMode"},
            {"action": "command", "feature": "PhenixImager", "command": "Connect", "params": {"PhenixHost": "SIM"}},
            {"action": "command", "feature": "SimulationController", "command": "StopSimulationMode"},
            {"action": "command", "feature": "PhenixImager", "command": "GoIdle", "expect_error": "NotConnected"}
          ]
        }
      ]
    },
    {
      "id": "stage",
      "name": "Stage Control",
      "description": "Stage in/out operations and error handling",
      "tests": [
        {
          "id": "stage_in",
          "name": "Stage In",
          "description": "Load plate onto stage",
          "modes": ["simulation"],
          "type": "scripted",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "command", "feature": "PhenixImager", "command": "StageIn", "params": {"PlateBarcode": "TEST-001"}}
          ]
        },
        {
          "id": "stage_out",
          "name": "Stage Out",
          "description": "Unload plate from stage",
          "modes": ["simulation"],
          "type": "scripted",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "command", "feature": "PhenixImager", "command": "StageIn", "params": {"PlateBarcode": "TEST-001"}},
            {"action": "command", "feature": "PhenixImager", "command": "StageOut", "params": {"PlateBarcode": "TEST-001"}}
          ]
        },
        {
          "id": "stage_not_connected",
          "name": "Stage When Disconnected",
          "description": "Verify NotConnected error when staging while disconnected",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "PhenixImager", "command": "Disconnect", "allow_error": true},
            {"action": "command", "feature": "PhenixImager", "command": "StageIn", "params": {"PlateBarcode": "TEST-001"}, "expect_error": "NotConnected"}
          ]
        },
        {
          "id": "stage_cycle",
          "name": "Stage Cycle",
          "description": "Multiple stage in/out operations",
          "modes": ["simulation"],
          "type": "scripted",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "command", "feature": "PhenixImager", "command": "StageIn", "params": {"PlateBarcode": "TEST-001"}},
            {"action": "command", "feature": "PhenixImager", "command": "StageOut", "params": {"PlateBarcode": "TEST-001"}},
            {"action": "command", "feature": "PhenixImager", "command": "StageIn", "params": {"PlateBarcode": "TEST-002"}},
            {"action": "command", "feature": "PhenixImager", "command": "StageOut", "params": {"PlateBarcode": "TEST-002"}}
          ]
        }
      ]
    },
    {
      "id": "acquisition",
      "name": "Acquisition",
      "description": "Acquisition protocol execution and state management",
      "tests": [
        {
          "id": "acq_run_protocol",
          "name": "Run Acquisition Protocol",
          "description": "Execute an acquisition protocol",
          "modes": ["simulation"],
          "type": "scripted",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "command", "feature": "PhenixImager", "command": "RunAcquisitionProtocol", "params": {"ProtocolName": "TestProtocol", "PlateBarcode": "TEST-001", "TimeoutMinutes": 5}},
            {"action": "check_response", "field": "Status", "operator": "not_empty"}
          ]
        },
        {
          "id": "acq_not_connected",
          "name": "Acquisition When Disconnected",
          "description": "Verify NotConnected error when running acquisition while disconnected",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "PhenixImager", "command": "Disconnect", "allow_error": true},
            {"action": "command", "feature": "PhenixImager", "command": "RunAcquisitionProtocol", "params": {"ProtocolName": "TestProtocol", "PlateBarcode": "TEST-001", "TimeoutMinutes": 5}, "expect_error": "NotConnected"}
          ]
        },
        {
          "id": "acq_go_idle",
          "name": "Go Idle",
          "description": "Set device to idle state",
          "modes": ["simulation"],
          "type": "scripted",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "command", "feature": "PhenixImager", "command": "GoIdle"}
          ]
        },
        {
          "id": "acq_go_standby",
          "name": "Go Standby",
          "description": "Set device to standby state for specified duration",
          "modes": ["simulation"],
          "type": "scripted",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "command", "feature": "PhenixImager", "command": "GoStandby", "params": {"DurationSeconds": 60}}
          ]
        }
      ]
    },
    {
      "id": "physical",
      "name": "Physical Hardware Tests",
      "description": "Tests requiring manual interaction with real hardware",
      "tests": [
        {
          "id": "phys_stage_in_out",
          "name": "Physical Stage In/Out",
          "description": "Manually verify stage motion with real plate",
          "modes": ["real"],
          "type": "guided",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "prompt", "message": "Place a plate near the stage inlet"},
            {"action": "command", "feature": "PhenixImager", "command": "StageIn", "params": {"PlateBarcode": "PHYS-TEST-001"}},
            {"action": "confirm", "message": "Did the plate move into the instrument?"},
            {"action": "command", "feature": "PhenixImager", "command": "StageOut", "params": {"PlateBarcode": "PHYS-TEST-001"}},
            {"action": "confirm", "message": "Did the plate move out of the instrument?"}
          ]
        },
        {
          "id": "phys_acquisition",
          "name": "Physical Acquisition",
          "description": "Run a real acquisition protocol",
          "modes": ["real"],
          "type": "guided",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "command", "feature": "PhenixImager", "command": "StageIn", "params": {"PlateBarcode": "PHYS-TEST-001"}},
            {"action": "prompt", "message": "Confirm the plate is loaded in the instrument"},
            {"action": "command", "feature": "PhenixImager", "command": "RunAcquisitionProtocol", "params": {"ProtocolName": "TestProtocol", "PlateBarcode": "PHYS-TEST-001", "TimeoutMinutes": 10}},
            {"action": "confirm", "message": "Did the acquisition complete successfully?"}
          ]
        },
        {
          "id": "phys_stop_acquisition",
          "name": "Stop Running Acquisition",
          "description": "Verify Stop command during acquisition",
          "modes": ["real"],
          "type": "guided",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "command", "feature": "PhenixImager", "command": "StageIn", "params": {"PlateBarcode": "PHYS-TEST-001"}},
            {"action": "prompt", "message": "Ready to start acquisition. You will press Stop after it begins."},
            {"action": "command", "feature": "PhenixImager", "command": "RunAcquisitionProtocol", "params": {"ProtocolName": "TestProtocol", "PlateBarcode": "PHYS-TEST-001", "TimeoutMinutes": 10}, "allow_error": true},
            {"action": "command", "feature": "PhenixImager", "command": "Stop"},
            {"action": "confirm", "message": "Did the acquisition stop?"}
          ]
        },
        {
          "id": "phys_network_disconnect",
          "name": "Network Disconnect Recovery",
          "description": "Verify error handling when network is disconnected",
          "modes": ["real"],
          "type": "guided",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "prompt", "message": "Disconnect the network cable from the Phenix imager"},
            {"action": "command", "feature": "PhenixImager", "command": "GoIdle", "allow_error": true},
            {"action": "confirm", "message": "Did an error occur?"},
            {"action": "prompt", "message": "Reconnect the network cable"},
            {"action": "command", "feature": "PhenixImager", "command": "Connect", "params": {"PhenixHost": "$PHENIX_HOST"}}
          ]
        },
        {
          "id": "phys_standby_wakeup",
          "name": "Standby and Wake Up",
          "description": "Verify standby mode and wake up",
          "modes": ["real"],
          "type": "guided",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "command", "feature": "PhenixImager", "command": "GoStandby", "params": {"DurationSeconds": 60}},
            {"action": "prompt", "message": "Verify the instrument is in standby mode (check physical indicators)"},
            {"action": "command", "feature": "PhenixImager", "command": "GoIdle"},
            {"action": "confirm", "message": "Did the instrument wake up from standby?"}
          ]
        }
      ]
    },
    {
      "id": "webui",
      "name": "WebUI Integration",
      "description": "Tests for WebUI observable property streaming and display",
      "tests": [
        {
          "id": "ui_sse_badge",
          "name": "SSE Live Indicator",
          "description": "Verify SSE LIVE badge appears in WebUI",
          "modes": ["simulation", "real"],
          "type": "guided",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "prompt", "message": "Open the Phenix Imager WebUI in the client"},
            {"action": "confirm", "message": "Do you see a green 'SSE LIVE' badge in the top-right corner?"}
          ]
        },
        {
          "id": "ui_acquisition_progress",
          "name": "Acquisition Progress Display",
          "description": "Verify acquisition progress updates in WebUI",
          "modes": ["simulation"],
          "type": "guided",
          "steps": [
            {"action": "ensure_connected"},
            {"action": "prompt", "message": "Open the Phenix Imager WebUI and watch for progress updates"},
            {"action": "command", "feature": "PhenixImager", "command": "RunAcquisitionProtocol", "params": {"ProtocolName": "TestProtocol", "PlateBarcode": "TEST-001", "TimeoutMinutes": 5}},
            {"action": "confirm", "message": "Did you see progress updates in the WebUI during acquisition?"}
          ]
        },
        {
          "id": "ui_sim_real_badge",
          "name": "Simulation Mode Badge",
          "description": "Verify simulation mode badge in WebUI",
          "modes": ["simulation", "real"],
          "type": "guided",
          "steps": [
            {"action": "command", "feature": "SimulationController", "command": "StartSimulationMode"},
            {"action": "prompt", "message": "Open the Phenix Imager WebUI"},
            {"action": "confirm", "message": "Do you see a 'SIMULATION' badge?"},
            {"action": "command", "feature": "SimulationController", "command": "StopSimulationMode"},
            {"action": "confirm", "message": "Did the simulation badge disappear or change to 'REAL'?"}
          ]
        }
      ]
    },
    {
      "id": "lock",
      "name": "LockController",
      "description": "Device locking and lock identifier enforcement",
      "tests": [
        {
          "id": "lock_request",
          "name": "Request Lock",
          "description": "Lock the device",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "LockController", "command": "RequestLock"},
            {"action": "check_response", "field": "LockIdentifier", "operator": "not_empty"}
          ]
        },
        {
          "id": "lock_release",
          "name": "Release Lock",
          "description": "Release a previously acquired lock",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "LockController", "command": "RequestLock"},
            {"action": "command", "feature": "LockController", "command": "ReleaseLock", "params": {"LockIdentifier": "$RESPONSE.LockIdentifier"}}
          ]
        },
        {
          "id": "lock_enforcement",
          "name": "Lock Enforcement",
          "description": "Verify commands require lock identifier when locked",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "LockController", "command": "RequestLock"},
            {"action": "ensure_connected"},
            {"action": "command", "feature": "PhenixImager", "command": "GoIdle", "params": {"LockIdentifier": "$RESPONSE.LockIdentifier"}}
          ]
        }
      ]
    },
    {
      "id": "logging",
      "name": "Structured Logging",
      "description": "ServerLogProvider query and filtering",
      "tests": [
        {
          "id": "log_query_all",
          "name": "Query All Logs",
          "description": "Retrieve all log entries",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ServerLogProvider", "command": "QueryLogs", "params": {"MaxRecords": 100}},
            {"action": "check_response", "field": "LogsJson", "operator": "not_empty"}
          ]
        },
        {
          "id": "log_query_level",
          "name": "Query by Level",
          "description": "Filter logs by severity level",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ServerLogProvider", "command": "QueryLogs", "params": {"MinLevel": "INFO", "MaxRecords": 50}},
            {"action": "check_response", "field": "LogsJson", "operator": "not_empty"}
          ]
        },
        {
          "id": "log_query_time",
          "name": "Query by Time Range",
          "description": "Filter logs by timestamp",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ServerLogProvider", "command": "QueryLogs", "params": {"StartTime": "2024-01-01T00:00:00Z", "MaxRecords": 100}},
            {"action": "check_response", "field": "LogsJson", "operator": "not_empty"}
          ]
        },
        {
          "id": "log_query_feature",
          "name": "Query by Feature",
          "description": "Filter logs by feature ID",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ServerLogProvider", "command": "QueryLogs", "params": {"FeatureId": "PhenixImager", "MaxRecords": 50}},
            {"action": "check_response", "field": "LogsJson", "operator": "not_empty"}
          ]
        },
        {
          "id": "log_clear",
          "name": "Clear Logs",
          "description": "Delete all log entries",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ServerLogProvider", "command": "ClearLogs"}
          ]
        },
        {
          "id": "log_export",
          "name": "Export Logs",
          "description": "Export logs as CSV",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ServerLogProvider", "command": "ExportLogs"},
            {"action": "check_response", "field": "CsvData", "operator": "not_empty"}
          ]
        }
      ]
    },
    {
      "id": "script_exec",
      "name": "Script Runner — Execution",
      "description": "Basic script execution, output handling, and lifecycle",
      "tests": [
        {
          "id": "exec_simple",
          "name": "Execute Simple Script",
          "description": "Run a minimal print script",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "ExecuteScript", "params": {"ScriptCode": "print('hello')"}},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "hello"},
            {"action": "check_response", "field": "ExitCode", "operator": "equals", "value": 0}
          ]
        },
        {
          "id": "exec_multiline",
          "name": "Execute Multi-line Script",
          "description": "Run a script with multiple statements",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "ExecuteScript", "params": {"ScriptCode": "for i in range(3):\n    print(f'Line {i}')\nprint('Done')"}},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "Line 0"},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "Line 1"},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "Line 2"},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "Done"},
            {"action": "check_response", "field": "ExitCode", "operator": "equals", "value": 0}
          ]
        },
        {
          "id": "exec_syntax_error",
          "name": "Syntax Error Handling",
          "description": "Verify script with syntax error fails gracefully",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "ExecuteScript", "params": {"ScriptCode": "print('missing closing quote)"}},
            {"action": "check_response", "field": "ExitCode", "operator": "not_equals", "value": 0},
            {"action": "check_response", "field": "Output", "operator": "not_empty"}
          ]
        },
        {
          "id": "exec_runtime_error",
          "name": "Runtime Error Handling",
          "description": "Verify script with runtime error fails gracefully",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "ExecuteScript", "params": {"ScriptCode": "x = 1 / 0"}},
            {"action": "check_response", "field": "ExitCode", "operator": "not_equals", "value": 0},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "ZeroDivisionError"}
          ]
        },
        {
          "id": "exec_empty",
          "name": "Execute Empty Script",
          "description": "Run an empty script (should succeed)",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "ExecuteScript", "params": {"ScriptCode": ""}},
            {"action": "check_response", "field": "ExitCode", "operator": "equals", "value": 0}
          ]
        },
        {
          "id": "exec_output_order",
          "name": "Output Order Preservation",
          "description": "Verify stdout/stderr are captured in order",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "ExecuteScript", "params": {"ScriptCode": "import sys\nprint('stdout1')\nprint('stderr1', file=sys.stderr)\nprint('stdout2')\nprint('stderr2', file=sys.stderr)"}},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "stdout1"},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "stderr1"},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "stdout2"},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "stderr2"},
            {"action": "check_response", "field": "ExitCode", "operator": "equals", "value": 0}
          ]
        },
        {
          "id": "exec_long_output",
          "name": "Long Output Handling",
          "description": "Verify scripts with large output are captured correctly",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "ExecuteScript", "params": {"ScriptCode": "for i in range(100):\n    print(f'Line {i:03d}')"}},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "Line 000"},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "Line 099"},
            {"action": "check_response", "field": "ExitCode", "operator": "equals", "value": 0}
          ]
        },
        {
          "id": "exec_unicode",
          "name": "Unicode Output",
          "description": "Verify Unicode characters are handled correctly",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "ExecuteScript", "params": {"ScriptCode": "print('Hello 世界 🌍')"}},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "Hello 世界 🌍"},
            {"action": "check_response", "field": "ExitCode", "operator": "equals", "value": 0}
          ]
        },
        {
          "id": "exec_import",
          "name": "Import Standard Library",
          "description": "Verify standard library imports work",
          "modes": ["simulation", "real"],
