      "id": "script_persist",
      "name": "Script Runner — Persistence",
      "description": "SaveScript, LoadScript, ListScripts, DeleteScript",
      "tests": [
        {
          "id": "persist_save",
          "name": "Save Script",
          "description": "SaveScript stores a script with metadata",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "SaveScript", "params": {"ScriptName": "test_save", "ScriptCode": "print('saved script')", "Description": "Test save"}}
          ]
        },
        {
          "id": "persist_load",
          "name": "Load Script",
          "description": "LoadScript retrieves saved script",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "SaveScript", "params": {"ScriptName": "test_load", "ScriptCode": "print('loaded')", "Description": "Test load"}},
            {"action": "command", "feature": "ScriptRunner", "command": "LoadScript", "params": {"ScriptName": "test_load"}},
            {"action": "check_response", "field": "ScriptCode", "operator": "contains", "value": "loaded"}
          ]
        },
        {
          "id": "persist_list",
          "name": "List Scripts",
          "description": "ListScripts returns all saved scripts",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "SaveScript", "params": {"ScriptName": "test_list_1", "ScriptCode": "print('1')", "Description": "First"}},
            {"action": "command", "feature": "ScriptRunner", "command": "SaveScript", "params": {"ScriptName": "test_list_2", "ScriptCode": "print('2')", "Description": "Second"}},
            {"action": "command", "feature": "ScriptRunner", "command": "ListScripts"},
            {"action": "check_response", "field": "ScriptsJson", "operator": "contains", "value": "test_list_1"},
            {"action": "check_response", "field": "ScriptsJson", "operator": "contains", "value": "test_list_2"}
          ]
        },
        {
          "id": "persist_delete",
          "name": "Delete Script",
          "description": "DeleteScript removes a saved script",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "SaveScript", "params": {"ScriptName": "test_delete", "ScriptCode": "print('delete me')", "Description": "To be deleted"}},
            {"action": "command", "feature": "ScriptRunner", "command": "DeleteScript", "params": {"ScriptName": "test_delete"}},
            {"action": "command", "feature": "ScriptRunner", "command": "LoadScript", "params": {"ScriptName": "test_delete"}, "expect_error": "ScriptNotFound"}
          ]
        },
        {
          "id": "persist_overwrite",
          "name": "Overwrite Script",
          "description": "SaveScript overwrites existing script",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "SaveScript", "params": {"ScriptName": "test_overwrite", "ScriptCode": "print('v1')", "Description": "Version 1"}},
            {"action": "command", "feature": "ScriptRunner", "command": "SaveScript", "params": {"ScriptName": "test_overwrite", "ScriptCode": "print('v2')", "Description": "Version 2"}},
            {"action": "command", "feature": "ScriptRunner", "command": "LoadScript", "params": {"ScriptName": "test_overwrite"}},
            {"action": "check_response", "field": "ScriptCode", "operator": "contains", "value": "v2"},
            {"action": "check_response", "field": "Description", "operator": "contains", "value": "Version 2"}
          ]
        },
        {
          "id": "persist_execute_saved",
          "name": "Execute Saved Script",
          "description": "ExecuteSavedScript runs a stored script",
          "modes": ["simulation", "real"],
          "type": "scripted",
          "steps": [
            {"action": "command", "feature": "ScriptRunner", "command": "SaveScript", "params": {"ScriptName": "test_exec_saved", "ScriptCode": "print('executed from storage')", "Description": "Test"}},
            {"action": "command", "feature": "ScriptRunner", "command": "ExecuteSavedScript", "params": {"ScriptName": "test_exec_saved"}},
            {"action": "check_response", "field": "Output", "operator": "contains", "value": "executed from storage"},
            {"action": "check_response", "field": "ExitCode", "operator": "equals", "value": 0}
          ]
        },
        {
          "id": "persist_load_notfound",
