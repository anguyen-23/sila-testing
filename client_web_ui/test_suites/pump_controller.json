              {"action": "command", "feature": "ScriptRunner", "command": "RunScript", "params": {"ScriptName": "t_devprops", "ScriptCode": "props = device.properties('ScriptRunner')\nfor p in props:\n    print(p)"}, "expect": "success"},
              {"action": "check_response", "field": "FullOutput", "condition": "contains", "value": "IsRunning"},
              {"action": "check_response", "field": "ExitCode", "condition": "equals", "value": 0}
