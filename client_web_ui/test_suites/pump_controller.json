    {
      "id": "script_persist",
      "name": "Script Runner — Persistence",
      "description": "Save, load, list, delete, and overwrite scripts stored on the server",
      "tests": [
        {
          "id": "persist_crud",
          "name": "Full CRUD round-trip",
          "type": "scripted",
          "modes": ["simulation", "real"],
          "description": "Save a script, verify it appears in list, load it back, then delete it.",
          "script": {
            "steps": [
              {"action": "command", "feature": "ScriptRunner", "command": "SaveScript", "params": {"ScriptName": "test_crud_abc", "ScriptCode": "print('crud_marker')"}, "expect": "success"},
              {"action": "command", "feature": "ScriptRunner", "command": "ListScripts", "params": {}, "expect": "success"},
              {"action": "check_response", "field": "Scripts", "condition": "contains", "value": "test_crud_abc"},
              {"action": "command", "feature": "ScriptRunner", "command": "LoadScript", "params": {"ScriptName": "test_crud_abc"}, "expect": "success"},
              {"action": "check_response", "field": "ScriptCode", "condition": "contains", "value": "crud_marker"},
              {"action": "command", "feature": "ScriptRunner", "command": "DeleteScript", "params": {"ScriptName": "test_crud_abc"}, "expect": "success"},
              {"action": "command", "feature": "ScriptRunner", "command": "LoadScript", "params": {"ScriptName": "test_crud_abc"}, "expect": "error", "error_type": "ScriptNotFound"}
            ]
          }
        },
        {
          "id": "persist_overwrite",
          "name": "Save overwrites existing script",
          "type": "scripted",
          "modes": ["simulation", "real"],
          "description": "Save a script, then save again with the same name but different code.",
          "script": {
            "steps": [
              {"action": "command", "feature": "ScriptRunner", "command": "SaveScript", "params": {"ScriptName": "test_overwrite", "ScriptCode": "print('version_one')"}, "expect": "success"},
              {"action": "command", "feature": "ScriptRunner", "command": "SaveScript", "params": {"ScriptName": "test_overwrite", "ScriptCode": "print('version_two')"}, "expect": "success"},
              {"action": "command", "feature": "ScriptRunner", "command": "LoadScript", "params": {"ScriptName": "test_overwrite"}, "expect": "success"},
              {"action": "check_response", "field": "ScriptCode", "condition": "contains", "value": "version_two"},
              {"action": "check_response", "field": "ScriptCode", "condition": "not_contains", "value": "version_one"},
              {"action": "command", "feature": "ScriptRunner", "command": "DeleteScript", "params": {"ScriptName": "test_overwrite"}, "expect": "success"}
            ]
          }
        },
        {
          "id": "persist_multiple",
