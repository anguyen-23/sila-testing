          "modes": ["simulation", "real"],
          "description": "Attempt to stop a script when none is running.",
          "script": {
            "steps": [
              {"action": "command", "feature": "ScriptRunner", "command": "StopScript", "params": {}, "expect": "error", "error_type": "ScriptError"}
            ]
          }
        },
        {
          "id": "err_name_error",
          "name": "NameError (undefined variable)",
          "type": "scripted",
          "modes": ["simulation", "real"],
          "description": "Run a script referencing an undefined variable.",
          "script": {
            "steps": [
              {"action": "command", "feature": "ScriptRunner", "command": "RunScript", "params": {"ScriptName": "t_name_err", "ScriptCode": "print(undefined_variable)"}, "expect": "success"},
              {"action": "check_response", "field": "ExitCode", "condition": "not_equals", "value": 0},
              {"action": "check_response", "field": "FullOutput", "condition": "contains", "value": "NameError"}
            ]
          }
        },
        {
          "id": "err_type_error",
          "name": "TypeError (wrong argument type)",
          "type": "scripted",
          "modes": ["simulation", "real"],
          "description": "Run a script that causes a TypeError.",
          "script": {
            "steps": [
              {"action": "command", "feature": "ScriptRunner", "command": "RunScript", "params": {"ScriptName": "t_type_err", "ScriptCode": "x = 'hello' + 42"}, "expect": "success"},
              {"action": "check_response", "field": "ExitCode", "condition": "not_equals", "value": 0},
              {"action": "check_response", "field": "FullOutput", "condition": "contains", "value": "TypeError"}
            ]
          }
        },
        {
          "id": "err_partial_output",
          "name": "Output captured before exception",
          "type": "scripted",
          "modes": ["simulation", "real"],
          "description": "Verify output printed before an exception is still captured.",
          "script": {
            "steps": [
              {"action": "command", "feature": "ScriptRunner", "command": "RunScript", "params": {"ScriptName": "t_partial", "ScriptCode": "print('before_crash')\nraise RuntimeError('boom')\nprint('after_crash')"}, "expect": "success"},
              {"action": "check_response", "field": "FullOutput", "condition": "contains", "value": "before_crash"},
              {"action": "check_response", "field": "FullOutput", "condition": "contains", "value": "RuntimeError"},
              {"action": "check_response", "field": "FullOutput", "condition": "not_contains", "value": "after_crash"},
              {"action": "check_response", "field": "ExitCode", "condition": "not_equals", "value": 0}
            ]
          }
        },
        {
          "id": "err_sys_exit",
          "name": "sys.exit() produces matching exit code",
          "type": "scripted",
          "modes": ["simulation", "real"],
          "description": "Verify that calling sys.exit(2) sets ExitCode to 2.",
          "script": {
            "steps": [
              {"action": "command", "feature": "ScriptRunner", "command": "RunScript", "params": {"ScriptName": "t_exit", "ScriptCode": "import sys\nprint('exiting')\nsys.exit(2)"}, "expect": "success"},
              {"action": "check_response", "field": "ExitCode", "condition": "equals", "value": 2},
              {"action": "check_response", "field": "FullOutput", "condition": "contains", "value": "exiting"}
            ]
          }
        },
        {
          "id": "err_clean_after_error",
          "name": "Server stable after script error",
          "type": "scripted",
          "modes": ["simulation", "real"],
          "description": "After a failed script, verify the server is still responsive.",
          "script": {
            "steps": [
              {"action": "command", "feature": "ScriptRunner", "command": "RunScript", "params": {"ScriptName": "t_err", "ScriptCode": "raise Exception('intentional')"}, "expect": "success"},
              {"action": "check_response", "field": "ExitCode", "condition": "not_equals", "value": 0},
              {"action": "command", "feature": "ScriptRunner", "command": "RunScript", "params": {"ScriptName": "t_ok", "ScriptCode": "print('recovered')"}, "expect": "success"},
              {"action": "check_response", "field": "FullOutput", "condition": "contains", "value": "recovered"},
              {"action": "check_response", "field": "ExitCode", "condition": "equals", "value": 0}
            ]
          }
        }
      ]
    }
