              {"action": "command", "feature": "ScriptRunner", "command": "ListScripts", "params": {}, "expect": "success"},
              {"action": "check_response", "field": "Scripts", "condition": "contains", "value": "test_multi_a"},
              {"action": "check_response", "field": "Scripts", "condition": "contains", "value": "test_multi_b"},
              {"action": "check_response", "field": "Scripts", "condition": "contains", "value": "test_multi_c"},
              {"action": "command", "feature": "ScriptRunner", "command": "DeleteScript", "params": {"ScriptName": "test_multi_a"}, "expect": "success"},
              {"action": "command", "feature": "ScriptRunner", "command": "DeleteScript", "params": {"ScriptName": "test_multi_b"}, "expect": "success"},
              {"action": "command", "feature": "ScriptRunner", "command": "DeleteScript", "params": {"ScriptName": "test_multi_c"}, "expect": "success"}
